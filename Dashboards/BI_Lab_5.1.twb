      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0502230036406272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales]) * 100' />
      </column>
      <column caption='Year to Date Sales' datatype='real' name='[Calculation_0502230036701185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])=YEAR(TODAY())&#13;&#10;THEN [Sales]&#13;&#10;END' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0502230037008386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales])-LOOKUP(SUM([Sales]),-1))/ABS(LOOKUP(SUM([Sales]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Select KPI' datatype='real' name='[Calculation_0502230044356612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0502230043893763]&#13;&#10;WHEN &quot;Sales&quot; THEN SUM([Sales])&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([Profit])&#13;&#10;WHEN &quot;Quantity&quot; THEN SUM([Quantity])&#13;&#10;END' />
      </column>
